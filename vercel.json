{
  "cleanUrls": true,
  "functions": { "api/eps/init.js": { "includeFiles": "js/data.js" } },
  "headers": [
    {
      "source": "/(.*)",
      "has": [ { "type": "host", "value": "(.*\\.vercel\\.app|staging\\..*)" } ],
      "headers": [ { "key": "X-Robots-Tag", "value": "noindex, nofollow" } ]
    }
  ]
}
