# EPS (Easy Payment System) — Vercel → Project → Settings → Environment Variables
EPS_USERNAME=
EPS_PASSWORD=
EPS_HASH_KEY=
EPS_MERCHANT_ID=
EPS_STORE_ID=
# true = sandbox (test), false or empty = live
EPS_SANDBOX=true

# Supabase — Vercel → Settings → Environment Variables
SUPABASE_URL=
SUPABASE_ANON_KEY=
# secret: server only (orders are written with this)
SUPABASE_SERVICE_ROLE_KEY=
